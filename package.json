{
  "name": "shifters-be",
  "packageManager": "pnpm@12.14.0",
  "version": "0.0.1",
  "description": "",
  "author": "maxisun",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "biome format --write ./src ./test ./scripts",
    "format:check": "biome format ./src ./test ./scripts",
    "lint": "biome lint ./src ./test ./scripts",
    "check": "biome check ./src ./test ./scripts",
    "contract:verify": "node scripts/contract-verify.mjs",
    "contract:generate": "openapi-typescript node_modules/@maxisun/shiftpatch-api/openapi.yaml -o src/generated/api/schema.d.ts",
    "contract:check": "openapi-typescript node_modules/@maxisun/shiftpatch-api/openapi.yaml -o src/generated/api/schema.d.ts --check",
    "db:migrate": "node --env-file-if-exists=.env dist/database/migrate.js",
    "db:migrate:build": "pnpm run build && pnpm run db:migrate",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "storage:smoke:r2": "pnpm run build && node --env-file-if-exists=.env dist/storage/storage-smoke-cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "posthog-node": "^5.61.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@maxisun/shiftpatch-api": "https://github.com/maxisun/shifters-specs/releases/download/api-v1.0.0/shiftpatch-api-1.0.0.tgz",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "openapi-typescript": "7.13.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
