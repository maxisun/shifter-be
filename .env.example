# Copy to .env for host-based development. Docker Compose overrides the
# service hostnames (postgres, minio) for containers. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false

DATABASE_URL=postgres://postgres:postgres@localhost:5432/shifters
POSTGRES_DB=shifters
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Local MinIO uses the same S3 client as Cloudflare R2.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=shiftpatch-local
S3_ACCESS_KEY_ID=shiftpatch-local
S3_SECRET_ACCESS_KEY=shiftpatch-local-secret
MINIO_ROOT_USER=shiftpatch-local
MINIO_ROOT_PASSWORD=shiftpatch-local-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Optional integrations. Leave empty to use the safe no-op adapters.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Sandbox/prod only. Keep these out of the repository.
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
